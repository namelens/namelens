# yamlfmt configuration for namelens
# Ensures consistent YAML formatting across local and CI environments

formatter:
  type: basic
  indent: 2
  line_ending: lf
  retain_line_breaks_single: true
  include_document_start: false
  # Match yamllint default (and goneat's pinned formatter behavior).
  # See goneat docs: appnotes/yaml-format-lint-alignment
  pad_line_comments: 2

exclude:
  - node_modules/**
  - vendor/**
  # In git worktrees, `.git` is a file (not a directory), which breaks
  # the `.git/**` glob (yamlfmt stat-fails the pattern). The bare `.git`
  # pattern excludes both the directory (primary checkout) and the file
  # (worktree) without triggering the stat.
  - .git
  - dist/**
  - bin/**
  - .cache/**
  - .plans/**
